{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
