# Copy to .env.test for local test commands. Never point these values at a hosted project.
RTS_TEST_MODE=1
SUPABASE_PROJECT_ID=rts-phase1-prototype
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-the-local-anon-key-from-supabase-status
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
AI_TEST_ADAPTER=fake

# OPENAI_API_KEY must remain unset for ordinary automated tests.
